<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the Gilded Fate theme (the same engine-free code the game draws with) to PNG files, so a design can be judged
       in seconds without a game build.   Usage: dotnet run with the project Tools/ThemePreview, then the output folder and an optional background.png
       Dev tool only: it is never part of the game or its builds. SkiaSharp is MIT licensed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0168;CS0219;CS0414;CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/Scripts/Theme/*.cs" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
  </ItemGroup>
</Project>
